<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.magiclane.sdk.core.GemSurfaceView
            android:id="@+id/gem_surface_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary"
            app:layout_constraintTop_toTopOf="parent"
            app:title="@string/app_name"
            app:titleTextColor="@color/on_primary"
            app:paddingTopWithSystemWindowInsets='@{"8dp"}'
            app:paddingLeftWithSystemWindowInsets='@{@dimen/small_padding}'
            app:paddingRightWithSystemWindowInsets='@{@dimen/small_padding}'
            android:paddingBottom="@dimen/toolbar_padding_bottom"
            />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress_bar"
            android:indeterminate="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottom_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/default_padding"
            android:background="@color/surface"
            android:elevation="@dimen/card_elevation"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:marginBottomWithSystemWindowInsets="@{@dimen/default_padding}"
            app:marginLeftWithSystemWindowInsets='@{@dimen/default_padding}'
            app:marginRightWithSystemWindowInsets='@{@dimen/default_padding}'>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/file_format_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/file_format"
                android:textSize="@dimen/label_text_size"
                android:textStyle="bold"
                android:layout_marginStart="@dimen/big_margin"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/file_formats_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:layout_constraintTop_toBottomOf="@id/file_format_text"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ff_gpx"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ff_gpx"
                    android:textAllCaps="false"
                    android:textSize="@dimen/tab_text_size" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ff_kml"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ff_kml"
                    android:textAllCaps="false"
                    android:textSize="@dimen/tab_text_size" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ff_json"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ff_json"
                    android:textAllCaps="false"
                    android:textSize="@dimen/tab_text_size" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ff_lat_lon"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ff_txt"
                    android:textAllCaps="false"
                    android:textSize="@dimen/tab_text_size" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/interval_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/interval_seconds"
                android:textSize="@dimen/label_text_size"
                android:textStyle="bold"
                android:layout_marginStart="@dimen/big_margin"
                android:layout_marginTop="@dimen/small_padding"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/file_formats_group"/>

            <com.google.android.material.slider.Slider
                android:id="@+id/interval_slider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                android:valueFrom="0.5"
                android:valueTo="10"
                android:stepSize="0.5"
                android:value="0.5"
                app:layout_constraintTop_toBottomOf="@id/interval_text"
                app:layout_constraintEnd_toStartOf="@id/seconds_text"
                app:layout_constraintStart_toStartOf="parent"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/seconds_text"
                android:layout_width="@dimen/seconds_view_width"
                android:layout_height="0dp"
                tools:text="10s "
                android:gravity="center"
                android:layout_margin="@dimen/default_padding"
                app:layout_constraintTop_toTopOf="@id/interval_slider"
                app:layout_constraintBottom_toBottomOf="@id/interval_slider"
                app:layout_constraintStart_toEndOf="@id/interval_slider"
                app:layout_constraintEnd_toEndOf="parent"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/follow_gps_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/default_padding"
            android:src="@drawable/ic_baseline_gps_fixed_24"
            android:visibility="gone"
            app:backgroundTint="@color/primary"
            app:layout_constraintBottom_toTopOf="@id/recording"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="@color/on_primary"
            tools:ignore="ContentDescription" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/recording"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/default_padding"
            android:foregroundTint="@color/start_color"
            android:src="@drawable/play_arrow_34"
            android:visibility="gone"
            app:backgroundTint="@color/start_color"
            app:layout_constraintBottom_toTopOf="@id/bottom_panel"
            app:layout_constraintEnd_toEndOf="parent"
            app:maxImageSize="36dp"
            app:tint="@android:color/white"
            tools:ignore="ContentDescription" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
