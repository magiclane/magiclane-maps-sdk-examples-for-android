<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MainActivity">

        <com.magiclane.sdk.core.GemSurfaceView
            android:id="@+id/gem_surface_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/top_panel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/nav_top_panel_padding"
            android:background="@color/black"
            android:elevation="@dimen/elevation_height"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone"
            app:marginTopWithSystemWindowInsets="@{@dimen/no_extra_inset}"
            app:marginLeftWithSystemWindowInsets="@{@dimen/no_extra_inset}"
            app:marginRightWithSystemWindowInsets="@{@dimen/no_extra_inset}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Turn info + instruction text row; keeps the fixed panel height on its own so the
                 panel can grow when the lane strip below is visible. -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/instruction_container"
                android:layout_width="0dp"
                android:layout_height="@dimen/nav_top_panel_height"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/turn_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/nav_top_panel_turn_margin"
                android:layout_marginEnd="@dimen/nav_top_panel_turn_margin"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/nav_icon"
                    android:layout_width="@dimen/turn_image_size"
                    android:layout_height="@dimen/turn_image_size"
                    app:layout_constraintBottom_toTopOf="@id/instr_distance"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="ContentDescription" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/instr_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/medium_text_size"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/nav_icon" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/nav_top_panel_turn_margin"
                android:layout_marginEnd="@dimen/nav_top_panel_turn_margin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/turn_container"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/road_code"
                        android:layout_width="@dimen/nav_top_panel_road_img_size"
                        android:layout_height="@dimen/nav_top_panel_road_img_size"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        tools:ignore="ContentDescription" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/nav_instruction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="3"
                        android:textColor="@color/white"
                        android:textSize="@dimen/nav_top_panel_instruction_text_size"
                        android:textStyle="bold" />

                </LinearLayout>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/sign_post"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    tools:ignore="ContentDescription" />

            </FrameLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!--
                Lane guidance along the panel's bottom side (TOP_PANEL placement). Shown by
                updateNavigationInstruction(); the panel grows to make room for it while visible.
            -->
            <ImageView
                android:id="@+id/top_lane_image"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/lane_panel_height"
                android:layout_marginStart="@dimen/lane_panel_padding"
                android:layout_marginTop="@dimen/lane_panel_padding"
                android:layout_marginEnd="@dimen/lane_panel_padding"
                android:layout_marginBottom="@dimen/lane_panel_padding"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/instruction_container"
                tools:ignore="ContentDescription" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/traffic_panel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:elevation="@dimen/elevation_height"
            android:visibility="gone"
            android:layout_marginStart="@dimen/nav_panel_margin"
            android:layout_marginEnd="@dimen/nav_panel_margin"
            app:marginLeftWithSystemWindowInsets="@{@dimen/no_extra_inset}"
            app:marginRightWithSystemWindowInsets="@{@dimen/no_extra_inset}"
            app:layout_constraintTop_toBottomOf="@id/top_panel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/traffic_image"
                android:layout_width="@dimen/nav_top_panel_traffic_img_size"
                android:layout_height="@dimen/nav_top_panel_traffic_img_size"
                android:layout_margin="@dimen/nav_panel_margin"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:ignore="ContentDescription" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/end_of_section_image"
                android:layout_width="@dimen/nav_top_panel_traffic_img_size"
                android:layout_height="@dimen/nav_top_panel_traffic_img_size"
                android:layout_margin="@dimen/nav_panel_margin"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:ignore="ContentDescription" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/traffic_event_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                android:textSize="@dimen/nav_top_panel_traffic_big_text_size"
                android:layout_marginStart="@dimen/nav_panel_margin"
                android:layout_marginEnd="@dimen/nav_top_panel_padding"
                app:layout_constraintStart_toEndOf="@id/traffic_image"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/distance_to_traffic_prefix" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/distance_to_traffic_prefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                android:textSize="@dimen/nav_top_panel_traffic_small_text_size"
                android:layout_marginStart="@dimen/nav_panel_margin"
                android:layout_marginBottom="@dimen/nav_top_panel_traffic_margin_bottom"
                app:layout_constraintStart_toEndOf="@id/traffic_image"
                app:layout_constraintTop_toBottomOf="@id/traffic_event_description"
                app:layout_constraintBottom_toBottomOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/distance_to_traffic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                android:textSize="@dimen/nav_top_panel_traffic_big_text_size"
                app:layout_constraintStart_toEndOf="@id/distance_to_traffic_prefix"
                app:layout_constraintBaseline_toBaselineOf="@id/distance_to_traffic_prefix" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/distance_to_traffic_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                android:textSize="@dimen/nav_top_panel_traffic_small_text_size"
                app:layout_constraintStart_toEndOf="@id/distance_to_traffic"
                app:layout_constraintBaseline_toBaselineOf="@id/distance_to_traffic_prefix" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/traffic_delay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                android:textSize="@dimen/nav_top_panel_traffic_big_text_size"
                android:gravity="end"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginStart="@dimen/nav_top_panel_traffic_delay_margin"
                android:layout_marginEnd="@dimen/nav_panel_margin"
                app:layout_constraintStart_toEndOf="@id/distance_to_traffic_unit"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBaseline_toBaselineOf="@id/distance_to_traffic_prefix" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!--
            Lane guidance panel (NEAR_ETA_PANEL placement). In portrait it sits centered just above
            the bottom panel; in landscape applyOrientationLayout() re-anchors it bottom-aligned
            with the bottom panel in the free space right of the docked panels, centered on the
            followed position when it fits there (see updateLandscapeLanePosition()).
        -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/lane_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/big_padding"
            android:layout_marginEnd="@dimen/big_padding"
            android:layout_marginBottom="@dimen/big_padding"
            android:background="@color/black"
            android:elevation="@dimen/elevation_height"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottom_panel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/lane_image"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/lane_panel_height"
                android:layout_margin="@dimen/lane_panel_padding"
                android:foregroundGravity="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="ContentDescription" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottom_panel"
            android:layout_width="0dp"
            android:layout_height="@dimen/bottom_panel_height"
            android:layout_margin="@dimen/big_padding"
            android:background="@color/white"
            android:elevation="@dimen/elevation_height"
            android:visibility="gone"
            app:marginLeftWithSystemWindowInsets="@{@dimen/no_extra_inset}"
            app:marginRightWithSystemWindowInsets="@{@dimen/no_extra_inset}"
            app:marginBottomWithSystemWindowInsets="@{@dimen/no_extra_inset}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/eta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/big_padding"
                android:textColor="@color/black"
                android:textSize="@dimen/medium_text_size"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/rtt"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/rtt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/big_padding"
                android:textColor="@color/black"
                android:textSize="@dimen/medium_text_size"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/rtd"
                app:layout_constraintStart_toEndOf="@id/eta"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/rtd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/big_padding"
                android:textColor="@color/black"
                android:textSize="@dimen/medium_text_size"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/rtt"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/follow_gps_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/big_padding"
            android:src="@drawable/ic_baseline_gps_fixed_24"
            android:visibility="gone"
            app:backgroundTint="@color/primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:marginBottomWithSystemWindowInsets="@{@dimen/no_extra_inset}"
            app:marginRightWithSystemWindowInsets="@{@dimen/no_extra_inset}"
            app:tint="@color/on_primary"
            tools:ignore="ContentDescription" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
