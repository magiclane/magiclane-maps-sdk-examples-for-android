<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <com.magiclane.sdk.core.GemSurfaceView
        android:id="@+id/gem_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:paddingLeftWithSystemWindowInsets="@{@dimen/small_padding}"
        app:paddingRightWithSystemWindowInsets="@{@dimen/small_padding}"
        app:paddingTopWithSystemWindowInsets='@{"8dp"}'
        app:title="@string/app_name"
        app:titleTextColor="@color/on_primary" />

    <com.google.android.material.textview.MaterialTextView
        android:clickable="true"
        android:id="@+id/status_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:focusable="true"
        android:padding="@dimen/big_padding"
        android:textSize="@dimen/standard_text_size"
        android:textStyle="bold"
        android:visibility="gone"
        android:textColor="@color/on_surface"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/status_progress_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:paddingBottomWithSystemWindowInsets='@{@dimen/no_extra_inset}'
        app:paddingLeftWithSystemWindowInsets='@{1f}' />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:clickable="true"
        android:id="@+id/status_progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:focusable="true"
        android:visibility="gone"
        android:indeterminate="true"
        android:background="@color/surface"
        app:layout_constraintBottom_toBottomOf="@id/status_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/status_text"
        app:layout_constraintTop_toTopOf="@id/status_text"
        app:paddingBottomWithSystemWindowInsets="@{@dimen/no_extra_inset}"
        app:paddingRightWithSystemWindowInsets="@{@dimen/small_padding}" />

</androidx.constraintlayout.widget.ConstraintLayout>
</layout>
