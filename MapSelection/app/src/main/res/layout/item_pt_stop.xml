<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:orientation="horizontal">

        <!-- Vertical timeline tinted with the route color; a circle marks each station. -->
        <FrameLayout
            android:id="@+id/timeline"
            android:layout_width="@dimen/pt_timeline_width"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/big_padding">

            <View
                android:id="@+id/timeline_circle"
                android:layout_width="@dimen/pt_timeline_circle_size"
                android:layout_height="@dimen/pt_timeline_circle_size"
                android:layout_gravity="center"
                android:background="@drawable/pt_stop_circle" />

        </FrameLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/stop_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/big_padding"
                android:layout_marginTop="@dimen/big_padding"
                android:layout_marginEnd="@dimen/big_padding"
                android:textColor="@color/on_background"
                android:textSize="@dimen/standard_text_size"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/stop_status"
                app:layout_constraintEnd_toStartOf="@id/stop_departure_time"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/stop_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/big_padding"
                android:layout_marginEnd="@dimen/big_padding"
                android:layout_marginBottom="@dimen/big_padding"
                android:textSize="@dimen/pt_small_text_size"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/stop_departure_time"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/stop_name" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/stop_departure_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/big_padding"
                android:textSize="@dimen/standard_text_size"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</layout>
