<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_rounded_black_button">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/navigation_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/nav_top_panel_min_height"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/nav_top_panel_padding"
            android:gravity="center_horizontal"
            android:textColor="@color/white"
            android:textSize="@dimen/nav_top_panel_status_text_size"
            android:maxLines="3"
            android:ellipsize="end"
            android:visibility="visible"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <LinearLayout
            android:id="@+id/turn_panel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/nav_top_panel_padding"
            android:layout_marginTop="@dimen/nav_top_panel_padding"
            android:layout_marginRight="@dimen/nav_top_panel_padding"
            android:layout_marginBottom="@dimen/nav_top_panel_padding"
            android:minWidth="@dimen/nav_top_panel_turn_min_width"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/road_instruction_container">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/turn_image"
                android:layout_width="@dimen/nav_top_panel_big_img_size"
                android:layout_height="@dimen/nav_top_panel_big_img_size"
                android:layout_gravity="center_horizontal"
                tools:ignore="ContentDescription" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layoutDirection="locale"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/turn_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="@dimen/nav_top_panel_turn_big_text_size"
                    android:textStyle="bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/turn_distance_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="@dimen/nav_top_panel_turn_small_text_size"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/road_instruction_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/nav_top_panel_padding"
            android:layout_marginBottom="@dimen/nav_top_panel_padding"
            android:layout_marginEnd="@dimen/nav_top_panel_padding"
            app:layout_constraintTop_toTopOf="@id/turn_panel"
            app:layout_constraintBottom_toBottomOf="@id/turn_panel"
            app:layout_constraintStart_toEndOf="@id/turn_panel"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                tools:ignore="UseCompoundDrawables">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/road_code"
                    android:layout_width="@dimen/nav_top_panel_road_img_size"
                    android:layout_height="@dimen/nav_top_panel_road_img_size"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    tools:ignore="ContentDescription" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/turn_instruction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="3"
                    android:textColor="@color/white"
                    android:textSize="@dimen/nav_top_panel_turn_medium_text_size" />
            </LinearLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/sign_post"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                tools:ignore="ContentDescription" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/traffic_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bottom_rounded_white_button"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/navigation_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/traffic_icon_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/traffic_image"
                android:layout_width="@dimen/nav_top_panel_traffic_img_size"
                android:layout_height="@dimen/nav_top_panel_traffic_img_size"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="@dimen/nav_top_panel_padding"
                android:layout_marginRight="@dimen/nav_top_panel_padding"
                android:layout_marginTop="@dimen/nav_top_panel_padding"
                android:layout_marginBottom="@dimen/nav_top_panel_padding"
                tools:ignore="ContentDescription" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/end_of_section_image"
                android:layout_width="@dimen/nav_top_panel_traffic_img_size"
                android:layout_height="@dimen/nav_top_panel_traffic_img_size"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="@dimen/nav_top_panel_padding"
                android:layout_marginRight="@dimen/nav_top_panel_padding"
                android:layout_marginTop="@dimen/nav_top_panel_padding"
                android:layout_marginBottom="@dimen/nav_top_panel_padding"
                android:visibility="gone"
                tools:ignore="ContentDescription" />
        </FrameLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/traffic_text_area"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/traffic_icon_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/traffic_event_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="@dimen/nav_top_panel_traffic_big_text_size"
                android:layout_marginEnd="@dimen/nav_top_panel_padding"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/traffic_info_row" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/traffic_info_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/nav_top_panel_traffic_margin_bottom"
                android:layoutDirection="locale"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/traffic_event_description"
                app:layout_constraintBottom_toBottomOf="parent">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/distance_to_traffic_prefix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="@dimen/nav_top_panel_traffic_small_text_size"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/distance_to_traffic"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintHorizontal_bias="0" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/distance_to_traffic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="@dimen/nav_top_panel_traffic_big_text_size"
                    app:layout_constraintStart_toEndOf="@id/distance_to_traffic_prefix"
                    app:layout_constraintEnd_toStartOf="@id/distance_to_traffic_unit"
                    app:layout_constraintBaseline_toBaselineOf="@id/distance_to_traffic_unit" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/distance_to_traffic_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="@dimen/nav_top_panel_traffic_small_text_size"
                    app:layout_constraintStart_toEndOf="@id/distance_to_traffic"
                    app:layout_constraintEnd_toStartOf="@id/distance_to_traffic_suffix"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/distance_to_traffic_suffix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="@dimen/nav_top_panel_traffic_small_text_size"
                    app:layout_constraintStart_toEndOf="@id/distance_to_traffic_unit"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/traffic_delay_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="@dimen/nav_top_panel_traffic_big_text_size"
                    app:layout_constraintEnd_toStartOf="@id/traffic_delay_time_unit"
                    app:layout_constraintBaseline_toBaselineOf="@id/traffic_delay_time_unit"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintHorizontal_bias="1"
                    app:layout_constraintStart_toStartOf="parent" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/traffic_delay_time_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/nav_top_panel_traffic_delay_margin"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="@dimen/nav_top_panel_traffic_small_text_size"
                    app:layout_constraintEnd_toStartOf="@id/traffic_delay_distance"
                    app:layout_constraintStart_toEndOf="@id/traffic_delay_time"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/traffic_delay_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="@dimen/nav_top_panel_traffic_big_text_size"
                    app:layout_constraintEnd_toStartOf="@id/traffic_delay_distance_unit"
                    app:layout_constraintStart_toEndOf="@id/traffic_delay_time_unit"
                    app:layout_constraintBaseline_toBaselineOf="@id/traffic_delay_distance_unit" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/traffic_delay_distance_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/nav_top_panel_padding"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="@dimen/nav_top_panel_traffic_small_text_size"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/traffic_delay_distance"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
