<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:minHeight="@dimen/icon_size"
    android:padding="@dimen/padding_10">

    <ImageView
        android:id="@+id/item_img"
        android:layout_width="@dimen/list_image_size"
        android:layout_height="@dimen/list_image_size"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:src="@drawable/bikeroad" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/item_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding_10"
        android:layout_marginEnd="@dimen/padding_10"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/on_surface"
        android:textDirection="locale"
        android:textSize="@dimen/standard_text_size"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/item_description"
        app:layout_constraintEnd_toStartOf="@id/item_distance"
        app:layout_constraintStart_toEndOf="@id/item_img"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Place name" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/item_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding_10"
        android:layout_marginEnd="@dimen/padding_10"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/on_surface"
        android:textDirection="locale"
        android:textSize="@dimen/small_text_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/item_distance"
        app:layout_constraintStart_toEndOf="@id/item_img"
        app:layout_constraintTop_toBottomOf="@id/item_text"
        tools:text="Description" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/item_distance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding_10"
        android:textColor="@color/on_surface"
        android:textSize="@dimen/standard_text_size"
        app:layout_constraintBottom_toTopOf="@id/item_unit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="1.2" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/item_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding_10"
        android:textColor="@color/on_surface"
        android:textSize="@dimen/small_text_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/item_distance"
        tools:text="km" />

</androidx.constraintlayout.widget.ConstraintLayout>
